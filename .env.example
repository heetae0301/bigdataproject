# 이 프로젝트를 실행하는 데 필요한 환경변수는 이제 이 두 개뿐입니다
# (Manus 플랫폼을 더 이상 쓰지 않아서, OAuth/DB/스토리지 관련 환경변수는 전부 제거했습니다).
#
# 사용법: 이 파일을 .env로 복사하고 값을 채우세요.
#   cp .env.example .env

# 사진 인식(OCR), 해설·칠판 대본 생성, 동그래 목소리에 쓰는 OpenAI API 키 (server/lib/ai.ts).
# https://platform.openai.com/api-keys 에서 발급한다. 쓴 만큼 요금이 나가니 예산 한도를 걸어 두세요.
OPENAI_API_KEY=

# 로그인 토큰(JWT) 서명에 쓰는 비밀 키. 아무 임의의 긴 문자열이면 됩니다.
# 비워두면 개발용 기본값으로 동작하지만, 실제 사용자가 접근할 수 있는 환경에서는 반드시 채우세요.
JWT_SECRET=

# 로컬 SQLite DB 파일 경로. 비워두면 프로젝트 루트의 local.db를 사용합니다.
# Turso 같은 원격 SQLite로 옮길 때만 libsql:// URL로 채우면 됩니다.
DATABASE_URL=

# DATABASE_URL을 Turso(libsql://...)로 설정했을 때만 필요한 인증 토큰.
# `turso db tokens create <db-name>`으로 발급받는다.
DATABASE_AUTH_TOKEN=

# Google 로그인 (서버 전용). Google Cloud Console의 "웹 애플리케이션" OAuth 클라이언트 ID와 보안 비밀번호.
# 그 클라이언트의 "승인된 리디렉션 URI"에 https://<API 서버>/api/auth/google/callback 을 등록해야 한다.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google 로그인 후 돌아갈 수 있는 Expo Go 개발 서버 주소(쉼표 구분, 호스트만).
# 같은 와이파이(사설 IP)는 자동 허용이라, ngrok 같은 외부 터널을 쓸 때만 적는다.
# 예: EXPO_RETURN_HOSTS=grant-lecturer-subtly.ngrok-free.dev
EXPO_RETURN_HOSTS=

# 비밀번호 찾기 인증코드 발송용 Brevo(구 Sendinblue) 계정.
# brevo.com 가입 > Settings > SMTP & API > API Keys에서 발급받는다.
# BREVO_SENDER_EMAIL은 Brevo에서 "발신자 인증"을 마친 이메일이어야 한다(도메인 인증은 불필요).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=



# 앱(Expo)이 API 서버를 찾을 주소.
# - 웹(브라우저)이나 iOS 시뮬레이터/Android 에뮬레이터에서 테스트할 때는 보통 비워둬도
#   자동으로 찾습니다 (constants/api.ts 참고).
# - 같은 와이파이의 실제 스마트폰에서 Expo Go로 테스트할 때는 반드시 이 컴퓨터의
#   LAN IP를 지정해야 합니다. 예:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.0.5:3000
EXPO_PUBLIC_API_BASE_URL=
